          "body": "<style>\n:root{--bg:#ffffff;--orange:#ff5b14;--ink:#111111;--muted:#666666;--line:#e6e6e6}\n*{box-sizing:border-box;margin:0;padding:0}\nhtml,body{background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",sans-serif;line-height:1.7}\na{color:inherit;text-decoration:none}\nmain{display:block}\n\n/* hero: 全宽色带分层堆叠 */\n.hero{border-bottom:1px solid var(--ink)}\n.hero-band{width:100%;padding:28px 5vw;border-bottom:1px solid var(--ink)}\n.hero-band-orange{background:var(--orange);color:#fff}\n.hero-band-orange h1{font-size:clamp(3rem,12vw,11rem);font-weight:900;letter-spacing:-0.04em;line-height:0.9}\n.hero-band-white{background:#fff;color:var(--ink)}\n.hero-band-white p{max-width:62ch;font-size:clamp(1rem,2.4vw,1.35rem)}\n.hero-band-dark{background:var(--ink);color:#fff}\n.hero-band-dark .meta{display:flex;flex-wrap:wrap;gap:32px;font-size:0.9rem;letter-spacing:0.04em}\n.hero-band-dark .meta span b{color:var(--orange)}\n\n/* nav: 底部固定式文字导航 */\n.navbar{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid var(--ink);z-index:50;padding:12px 5vw;display:flex;justify-content:space-between;align-items:center;font-size:0.85rem}\n.navbar .brand{font-weight:800;letter-spacing:0.02em}\n.navbar .links{display:flex;gap:18px;flex-wrap:wrap}\n.navbar .links a{border-bottom:1px solid transparent}\n.navbar .links a:hover{border-bottom-color:var(--orange)}\nbody{padding-bottom:64px}\n\n/* section common */\nsection{padding:64px 5vw;border-bottom:1px solid var(--ink)}\nh2{font-size:clamp(1.6rem,4vw,2.4rem);font-weight:800;letter-spacing:-0.02em;margin-bottom:18px}\n.lede{max-width:64ch;font-size:1.1rem;color:#222;margin-bottom:32px}\n\n/* card: 左侧色条标记 */\n.card-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:0;border:1px solid var(--ink)}\n.card{border-right:1px solid var(--line);padding:28px 24px;position:relative}\n.card